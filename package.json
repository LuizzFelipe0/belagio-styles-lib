{
  "name": "belagio-styles-lib",
  "version": "0.1.0",
  "description": "Reusable TypeScript UI component library built for internal projects, featuring iOS-inspired minimalist design.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./PrimalButton": {
      "import": "./dist/components/PrimalButton/index.js",
      "require": "./dist/components/PrimalButton/index.cjs",
      "types": "./dist/components/PrimalButton/index.d.ts"
    },
    "./Input": {
      "import": "./dist/components/Input/index.js",
      "require": "./dist/components/Input/index.cjs",
      "types": "./dist/components/Input/index.d.ts"
    },
    "./PrimalCard": {
      "import": "./dist/components/PrimalCard/index.js",
      "require": "./dist/components/PrimalCard/index.cjs",
      "types": "./dist/components/PrimalCard/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "NODE_ENV=production tsc && NODE_ENV=production vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^15.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^24.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^3.9.0",
    "vitest": "^1.6.0"
  }
}